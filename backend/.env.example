DATABASE_URL="postgresql://user:password@localhost:5432/transpak_fleet"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
# Окремий секрет для онбордингу нових клієнтів платформи через /api/platform/*
# (POST /companies, /users) — не пов'язаний з роллю admin/viewer жодної компанії.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_ADMIN_KEY="replace-with-a-long-random-string"
