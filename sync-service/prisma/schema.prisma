// Копія backend/prisma/schema.prisma — потрібна, щоб sync-service мав власний,
// самодостатній Prisma-клієнт (без залежності на backend/node_modules) для окремого
// деплою на Railway. Джерело істини й міграції — виключно в backend/prisma.
// При зміні backend-схеми синхронізувати цей файл вручну.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  viewer
}

enum TruckStatus {
  trip
  free
  service
  repair
}

enum RepairType {
  planned
  unplanned
}

enum RepairStatus {
  in_progress
  done
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(viewer)
  telegramChatId String?
  createdAt    DateTime @default(now())
  notifications Notification[]
}

model Driver {
  id         String  @id @default(uuid())
  fullName   String
  experienceYears Int?
  trucks     Truck[]
}

model Truck {
  id             String   @id @default(uuid())
  plate          String   @unique
  model          String
  status         TruckStatus @default(free)
  wialonUnitId   String?  @unique
  totalMileageKm Int      @default(0)
  mileageBaselineKm Int?
  mileageBaselineAt DateTime?
  fuelNormL100km Float?
  driverId       String?
  driver         Driver?  @relation(fields: [driverId], references: [id])

  maintenanceStatuses TruckMaintenanceStatus[]
  overrides           TruckMaintenanceOverride[]
  maintenanceLogs      MaintenanceLog[]
  repairs              Repair[]
  mileageLogs           MileageLog[]
  fuelLogs               FuelLog[]
  routeLogs               RouteLog[]
}

model MaintenanceType {
  id            String  @id @default(uuid())
  key           String  @unique
  name          String
  intervalKm    Int?
  intervalDays  Int?
  soonKm        Int     @default(0)
  soonDays      Int     @default(0)
  allowOverride Boolean @default(true)

  truckStatuses TruckMaintenanceStatus[]
  overrides     TruckMaintenanceOverride[]
  logs          MaintenanceLog[]
}

model TruckMaintenanceStatus {
  id                String   @id @default(uuid())
  truckId           String
  truck             Truck    @relation(fields: [truckId], references: [id])
  maintenanceTypeId String
  maintenanceType   MaintenanceType @relation(fields: [maintenanceTypeId], references: [id])
  lastDoneAtKm      Int?
  lastDoneAtDate    DateTime?

  @@unique([truckId, maintenanceTypeId])
}

model TruckMaintenanceOverride {
  id                String   @id @default(uuid())
  truckId           String
  truck             Truck    @relation(fields: [truckId], references: [id])
  maintenanceTypeId String
  maintenanceType   MaintenanceType @relation(fields: [maintenanceTypeId], references: [id])
  overrideIntervalKm   Int?
  overrideIntervalDays Int?

  @@unique([truckId, maintenanceTypeId])
}

model MaintenanceLog {
  id                String   @id @default(uuid())
  truckId           String
  truck             Truck    @relation(fields: [truckId], references: [id])
  maintenanceTypeId String
  maintenanceType   MaintenanceType @relation(fields: [maintenanceTypeId], references: [id])
  performedAtKm     Int?
  performedAtDate   DateTime @default(now())
  performedBy       String?
  costUah           Float?
  notes             String?
}

model Repair {
  id           String       @id @default(uuid())
  truckId      String
  truck        Truck        @relation(fields: [truckId], references: [id])
  type         RepairType
  description  String
  date         DateTime     @default(now())
  downtimeDays Int?
  costUah      Float?
  status       RepairStatus @default(in_progress)
}

model MileageLog {
  id      String   @id @default(uuid())
  truckId String
  truck   Truck    @relation(fields: [truckId], references: [id])
  date    DateTime
  km      Int

  @@unique([truckId, date])
}

model FuelLog {
  id           String   @id @default(uuid())
  truckId      String
  truck        Truck    @relation(fields: [truckId], references: [id])
  date         DateTime
  litersPer100km Float

  @@unique([truckId, date])
}

model RouteLog {
  id        String   @id @default(uuid())
  truckId   String
  truck     Truck    @relation(fields: [truckId], references: [id])
  fromCity  String
  toCity    String
  distanceKm Int
  date      DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  text      String
  createdAt DateTime @default(now())
  readAt    DateTime?
  sentToTelegram Boolean @default(false)
}
