DATABASE_URL="postgresql://user:password@localhost:5432/transpak_fleet"
WIALON_BASE_URL="https://hst-api.wialon.com/wialon/ajax.html"
WIALON_TOKEN="replace-with-real-wialon-access-token"
# Ресурс/шаблон звіту "Пробіг" у Wialon (Reports) — специфічні для акаунту,
# знайти через core/search_items (itemsType avl_resource) -> item.rep
WIALON_REPORT_RESOURCE_ID="799052"
WIALON_REPORT_TEMPLATE_ID="1"
# Геозона бази (депо) для визначення статусу "На базі" vs "В рейсі" — рух ТЗ тут ролі не
# грає, важлива лише відстань від депо (див. sync-service/src/index.ts)
DEPOT_LAT="49.3295"
DEPOT_LON="24.0915"
DEPOT_RADIUS_KM="2"
# Ресурс з довідником водіїв Wialon (core/search_item -> item.drvrs), для одноразового
# імпорту (npm run import-drivers -- у sync-service)
WIALON_DRIVERS_RESOURCE_ID="18412006"
