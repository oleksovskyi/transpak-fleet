{
  "name": "transpak-fleet-sync-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "sync:once": "tsx src/index.ts --once",
    "mileage:once": "tsx src/index.ts --mileage-once",
